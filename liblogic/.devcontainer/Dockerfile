FROM opensuse/leap:16.0
RUN useradd -ms /bin/bash vscode
RUN zypper --gpg-auto-import-keys addrepo -f https://download.opensuse.org/repositories/Kernel:tools/16.0/Kernel:tools.repo && zypper --gpg-auto-import-keys refresh && zypper --gpg-auto-import-keys install -y icu libicu-devel libboost_headers-devel cmake git openssh gcc conan antlr4 libantlr4-runtime-devel libantlr4-runtime4_13_0 libantlr4-runtime4_13_0-debuginfo nlohmann-json gcc-c++